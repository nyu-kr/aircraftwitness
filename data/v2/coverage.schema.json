{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:geoloc:passes-coverage:v2",
 "title": "v2 per-recording coverage: the v1 coverage row plus time grade, flight source and receiver-coverage fields",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "recording_id",
  "source",
  "cut_status",
  "cut_reference",
  "recording_start_utc",
  "recording_end_utc",
  "input_sample_count",
  "sample_count_during_recording",
  "usable_altitude_sample_count",
  "missing_altitude_sample_count",
  "invalid_position_or_identity_sample_count",
  "duplicate_sample_count",
  "gaps_over_60s_count",
  "max_aircraft_gap_s",
  "first_sample_utc",
  "last_sample_utc",
  "pass_count",
  "all_aircraft_completeness",
  "altitude_reference_uncertainty",
  "observer_elevation_m",
  "observer_elevation_basis",
  "sampling_method",
  "max_contiguous_gap_s",
  "coverage_caveat",
  "recording_time_basis",
  "recording_time_precision_s",
  "recording_position_basis",
  "upstream_cut_filters",
  "invalid_metadata_reason",
  "withheld_reason",
  "observed_samples_above_33000ft",
  "observed_passes_above_33000ft",
  "omitted_passes_due_to_upstream_cap",
  "uncapped_daily_data_used",
  "recording_position_precision_m",
  "duration_basis",
  "recording_time_grade",
  "flight_source",
  "flight_source_days",
  "flight_source_caps",
  "receiver_aircraft_within_50km_utc_day",
  "receiver_points_within_50km_utc_day",
  "receiver_utc_hours_with_aircraft_within_50km",
  "archive_utc_hours_without_data"
 ],
 "properties": {
  "recording_id": {
   "type": "string",
   "minLength": 1
  },
  "source": {
   "type": "string",
   "minLength": 1
  },
  "cut_status": {
   "enum": [
    "present",
    "missing",
    "invalid_metadata",
    "withheld"
   ]
  },
  "withheld_reason": {
   "type": [
    "string",
    "null"
   ]
  },
  "observed_samples_above_33000ft": {
   "type": "integer",
   "minimum": 0
  },
  "observed_passes_above_33000ft": {
   "type": "integer",
   "minimum": 0
  },
  "omitted_passes_due_to_upstream_cap": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 0,
   "description": "Unknown remains null, never inferred zero from capped inputs."
  },
  "uncapped_daily_data_used": {
   "type": "boolean"
  },
  "recording_position_precision_m": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0
  },
  "invalid_metadata_reason": {
   "type": [
    "string",
    "null"
   ]
  },
  "cut_reference": {
   "type": "string",
   "minLength": 1
  },
  "recording_start_utc": {
   "type": [
    "string",
    "null"
   ],
   "format": "date-time"
  },
  "recording_end_utc": {
   "type": [
    "string",
    "null"
   ],
   "format": "date-time"
  },
  "input_sample_count": {
   "type": "integer",
   "minimum": 0
  },
  "sample_count_during_recording": {
   "type": "integer",
   "minimum": 0
  },
  "usable_altitude_sample_count": {
   "type": "integer",
   "minimum": 0
  },
  "missing_altitude_sample_count": {
   "type": "integer",
   "minimum": 0
  },
  "invalid_position_or_identity_sample_count": {
   "type": "integer",
   "minimum": 0
  },
  "duplicate_sample_count": {
   "type": "integer",
   "minimum": 0
  },
  "gaps_over_60s_count": {
   "type": "integer",
   "minimum": 0
  },
  "max_aircraft_gap_s": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0
  },
  "first_sample_utc": {
   "type": [
    "string",
    "null"
   ],
   "format": "date-time"
  },
  "last_sample_utc": {
   "type": [
    "string",
    "null"
   ],
   "format": "date-time"
  },
  "pass_count": {
   "type": "integer",
   "minimum": 0,
   "description": "Must exactly equal passes.jsonl rows for this recording; zero with missing cut is not an absence label."
  },
  "all_aircraft_completeness": {
   "const": false
  },
  "altitude_reference_uncertainty": {
   "const": true
  },
  "observer_elevation_m": {
   "type": [
    "number",
    "null"
   ]
  },
  "observer_elevation_basis": {
   "type": "string",
   "minLength": 1
  },
  "sampling_method": {
   "type": "string",
   "minLength": 1
  },
  "max_contiguous_gap_s": {
   "const": 60
  },
  "coverage_caveat": {
   "type": "string",
   "minLength": 1
  },
  "recording_time_basis": {
   "type": "string",
   "description": "Copied from current approved recordings.csv, including inferred or unreliable clock cases."
  },
  "recording_time_precision_s": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0
  },
  "recording_position_basis": {
   "type": "string",
   "minLength": 1
  },
  "upstream_cut_filters": {
   "type": "string",
   "minLength": 1
  },
  "duration_basis": {
   "type": "string",
   "minLength": 1,
   "description": "source metadata, or an assumed 300 s window when the source gives no duration"
  },
  "recording_time_grade": {
   "enum": [
    "gps",
    "ntp",
    "device",
    "phone",
    "typed",
    "unknown"
   ]
  },
  "flight_source": {
   "const": "adsb.lol"
  },
  "flight_source_days": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   },
   "description": "UTC days of the adsb.lol archive the recording spans"
  },
  "flight_source_caps": {
   "type": "string",
   "minLength": 1
  },
  "receiver_aircraft_within_50km_utc_day": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0
   },
   "description": "per flight_source_days: distinct aircraft the archive saw within 50 km of the place that UTC day; 0 means zero passes are unknown, not quiet"
  },
  "receiver_points_within_50km_utc_day": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0
   },
   "description": "per flight_source_days: positions within 50 km that UTC day"
  },
  "receiver_utc_hours_with_aircraft_within_50km": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0,
    "maximum": 24
   }
  },
  "archive_utc_hours_without_data": {
   "type": "array",
   "items": {
    "type": "array",
    "items": {
     "type": "integer",
     "minimum": 0,
     "maximum": 23
    }
   },
   "description": "per flight_source_days: UTC hours with no positions anywhere in the archive"
  }
 }
}